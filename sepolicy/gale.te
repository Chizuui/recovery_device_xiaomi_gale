# Xiaomi gale (Redmi 13C / Poco C65) - OrangeFox recovery extras
# recovery/init are declared permissive by bootable/recovery/sepolicy/twrp.te.
# Only rules that pass the platform neverallow checks are listed here; the
# remaining (rootfs/sysfs/media_rw writes) are neverallow-protected and stay
# logged as permissive denials by design.

# Device-mapper block device size/probe ioctls (BLKGETSIZE64 etc.) for logical partitions
allow recovery dm_device:blk_file ioctl;

# Recovery creates its own directories in the ramdisk rootfs
allow recovery rootfs:dir write;

# Read internal storage for screenshots/logs/settings
allow recovery media_rw_data_file:dir { search getattr };
allow recovery media_rw_data_file:file { getattr read };

# dmesg access from the recovery terminal
allow recovery kmsg_device:chr_file write;

# init writes the BCB (misc) when rebooting to recovery/fastboot
allow init block_device:blk_file write;
